generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id                        String                    @id @default(cuid())
  firstName                 String
  lastName                  String?
  email                     String                    @unique
  passwordHash              String
  mobile                    String?
  status                    UserStatus                @default(ACTIVE)
  roleId                    String
  lastLoginAt               DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  activities                Activity[]
  sessions                  AuthSession[]
  assignedClients           Client[]                  @relation("ClientAssignedBDE")
  clientsCreated            Client[]                  @relation("ClientCreatedBy")
  clientServiceSelections   ClientServiceSelection[]
  approvedIncentivePayouts  IncentivePayout[]         @relation("IncentivePayoutApprovedBy")
  incentivePayouts          IncentivePayout[]         @relation("IncentivePayoutBDE")
  assignedLeads             Lead[]
  createdLeads              Lead[]                    @relation("LeadCreatedBy")
  leadServiceSelections     LeadServiceSelection[]
  notifications             Notification[]
  psgasAsBde                PSGA[]                    @relation("PSGABDE")
  adminIncentiveAllocations PSGAIncentiveAllocation[] @relation("IncentiveAdmin")
  approvedIncentives        PSGAIncentiveAllocation[] @relation("IncentiveApprovedBy")
  incentiveAllocations      PSGAIncentiveAllocation[] @relation("IncentiveBDE")
  role                      Role                      @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([status])
}

model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tokenId   String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Lead {
  id                String                 @id @default(cuid())
  contactName       String
  email             String?
  mobile            String?
  source            String?
  notes             String?
  status            LeadStatus             @default(NEW)
  assignedToId      String?
  createdById       String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  associationName   String
  clientId          String?                @unique
  address           String?
  city              String?
  customerType      String?
  followUpRemarks   String?
  nextAction        String?
  nextFollowUpAt    DateTime?
  pincode           String?
  siteAddress       String?
  siteCity          String?
  siteName          String?
  siteState         String?
  state             String?
  activities        Activity[]
  assignedTo        User?                  @relation(fields: [assignedToId], references: [id])
  client            Client?                @relation("LeadClient", fields: [clientId], references: [id])
  createdBy         User                   @relation("LeadCreatedBy", fields: [createdById], references: [id])
  assets            LeadAsset[]
  serviceSelections LeadServiceSelection[]
  psgas             PSGA[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdById])
  @@index([email])
  @@index([mobile])
  @@index([customerType])
  @@index([nextFollowUpAt])
  @@index([city])
  @@index([state])
}

model LeadAsset {
  id                     String   @id @default(cuid())
  leadId                 String
  assetName              String?
  assetReference         String?
  installationLocation   String?
  manufacturer           String?
  model                  String?
  installationYear       Int?
  existingAmc            String?
  currentServiceProvider String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  lead                   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([assetReference])
}

model Client {
  id                String                   @id @default(cuid())
  associationName   String
  contactName       String
  email             String?
  mobile            String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  gstNumber         String?
  status            ClientStatus             @default(ACTIVE)
  createdById       String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  assignedBdeId     String?
  externalClientId  String?
  fsoGeneratedAt    DateTime?
  fsoNumber         String?
  processStage      ClientProcessStage       @default(CLIENT_CREATED)
  processUpdatedAt  DateTime?
  psgaGeneratedAt   DateTime?
  activities        Activity[]
  assignedBde       User?                    @relation("ClientAssignedBDE", fields: [assignedBdeId], references: [id])
  createdBy         User                     @relation("ClientCreatedBy", fields: [createdById], references: [id])
  serviceSelections ClientServiceSelection[]
  sourceLead        Lead?                    @relation("LeadClient")
  psgas             PSGA[]

  @@index([associationName])
  @@index([email])
  @@index([mobile])
  @@index([status])
  @@index([createdById])
  @@index([assignedBdeId])
  @@index([processStage])
  @@index([externalClientId])
  @@index([fsoNumber])
}

model Activity {
  id          String         @id @default(cuid())
  type        ActivityType
  subject     String
  description String?
  followUpAt  DateTime?
  status      ActivityStatus @default(PENDING)
  leadId      String?
  clientId    String?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User           @relation(fields: [createdById], references: [id])
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([status])
  @@index([followUpAt])
  @@index([leadId])
  @@index([clientId])
  @@index([createdById])
}

model Notification {
  id              String           @id @default(cuid())
  type            NotificationType
  title           String
  message         String
  isRead          Boolean          @default(false)
  recipientId     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  notificationKey String?
  referenceId     String?
  referenceType   String?
  recipient       User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, notificationKey])
  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
  @@index([referenceId])
  @@index([referenceType])
}

model ServiceCatalog {
  id               String                   @id @default(cuid())
  code             String                   @unique
  name             String
  description      String?
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  clientSelections ClientServiceSelection[]
  leadSelections   LeadServiceSelection[]
  pricingRules     ServicePricingRule[]

  @@index([isActive])
}

model ServicePricingRule {
  id            String         @id @default(cuid())
  serviceId     String
  pricingBasis  PricingBasis
  pricingLabel  String?
  assetCategory String?
  minQuantity   Int?
  maxQuantity   Int?
  unitRate      Decimal        @db.Decimal(12, 2)
  gstPercent    Decimal        @default(18) @db.Decimal(5, 2)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  service       ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([pricingBasis])
  @@index([isActive])
}

model LeadServiceSelection {
  id            String         @id @default(cuid())
  leadId        String
  serviceId     String
  serviceCode   String
  serviceName   String
  pricingBasis  PricingBasis
  pricingLabel  String?
  assetCategory String?
  quantity      Decimal        @default(1) @db.Decimal(12, 2)
  unitRate      Decimal        @db.Decimal(12, 2)
  baseAmount    Decimal        @db.Decimal(14, 2)
  gstPercent    Decimal        @default(18) @db.Decimal(5, 2)
  gstAmount     Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal        @db.Decimal(14, 2)
  notes         String?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     User           @relation(fields: [createdById], references: [id])
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service       ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@index([leadId])
  @@index([serviceId])
  @@index([createdById])
}

model ClientServiceSelection {
  id            String         @id @default(cuid())
  clientId      String
  serviceId     String
  serviceCode   String
  serviceName   String
  pricingBasis  PricingBasis
  pricingLabel  String?
  assetCategory String?
  quantity      Decimal        @default(1) @db.Decimal(12, 2)
  unitRate      Decimal        @db.Decimal(12, 2)
  baseAmount    Decimal        @db.Decimal(14, 2)
  gstPercent    Decimal        @default(18) @db.Decimal(5, 2)
  gstAmount     Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal        @db.Decimal(14, 2)
  notes         String?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy     User           @relation(fields: [createdById], references: [id])
  service       ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@index([clientId])
  @@index([serviceId])
  @@index([createdById])
}

model PSGA {
  id                   String                    @id @default(cuid())
  psgNumber            String                    @unique
  status               PSGAStatus                @default(GENERATED)
  generatedAt          DateTime                  @default(now())
  sentAt               DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  clientId             String
  leadId               String?
  bdeId                String?
  incentiveStatus      IncentiveStatus           @default(NOT_ELIGIBLE)
  incentiveApprovedAt  DateTime?
  incentivePaidAt      DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  bde                  User?                     @relation("PSGABDE", fields: [bdeId], references: [id])
  client               Client                    @relation(fields: [clientId], references: [id])
  lead                 Lead?                     @relation(fields: [leadId], references: [id])
  incentiveAllocations PSGAIncentiveAllocation[]

  @@index([clientId])
  @@index([leadId])
  @@index([bdeId])
  @@index([status])
  @@index([incentiveStatus])
}

model PSGAIncentiveAllocation {
  id               String                 @id @default(cuid())
  psgId            String
  bdeId            String?
  role             IncentiveRole
  reason           String?
  incentivePercent Decimal                @db.Decimal(5, 2)
  status           IncentiveStatus        @default(NOT_ELIGIBLE)
  approvedById     String?
  approvedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  adminId          String?
  recipientType    IncentiveRecipientType @default(BDE)
  admin            User?                  @relation("IncentiveAdmin", fields: [adminId], references: [id])
  approvedBy       User?                  @relation("IncentiveApprovedBy", fields: [approvedById], references: [id])
  bde              User?                  @relation("IncentiveBDE", fields: [bdeId], references: [id])
  psg              PSGA                   @relation(fields: [psgId], references: [id], onDelete: Cascade)

  @@index([psgId])
  @@index([bdeId])
  @@index([adminId])
  @@index([approvedById])
  @@index([status])
  @@index([role])
  @@index([recipientType])
}

model IncentivePayout {
  id                    String                @id @default(cuid())
  bdeId                 String
  salaryMonth           DateTime
  status                IncentivePayoutStatus @default(PENDING)
  approvedById          String?
  approvedAt            DateTime?
  paidAt                DateTime?
  paymentReference      String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  totalIncentivePercent Decimal               @db.Decimal(7, 2)
  approvedBy            User?                 @relation("IncentivePayoutApprovedBy", fields: [approvedById], references: [id])
  bde                   User                  @relation("IncentivePayoutBDE", fields: [bdeId], references: [id])

  @@unique([bdeId, salaryMonth])
  @@index([bdeId])
  @@index([salaryMonth])
  @@index([status])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum ClientProcessStage {
  CLIENT_CREATED
  FSO_GENERATED
  PSGA_GENERATED
  PSGA_COMPLETED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ActivityType {
  CALL
  MEETING
  FOLLOW_UP
  EMAIL
  NOTE
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  LEAD_ASSIGNED
  FOLLOW_UP_DUE
  FOLLOW_UP_OVERDUE
  LEAD_CONVERTED
  ACTIVITY_CREATED
  GENERAL
  FOLLOW_UP_REMINDER
}

enum PricingBasis {
  SERVICE_RATE
  ASSET_CATEGORY
  LIFT_COUNT
  CUSTOM
}

enum PSGAStatus {
  GENERATED
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

enum IncentiveStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  APPROVED
  PAID
}

enum IncentiveRole {
  PRIMARY
  SUPPORTING
}

enum IncentiveRecipientType {
  BDE
  ADMIN
}

enum IncentivePayoutStatus {
  PENDING
  APPROVED
  PAID
}
